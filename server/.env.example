# ──────────────────────────────────────────────────────────────
# Arts by Jay — server environment
# Copy to `server/.env` and fill in. NEVER commit the real .env.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# ── Database ──────────────────────────────────────────────────
# Use a real MongoDB (Atlas or local install) in any shared or
# production environment.
MONGODB_URI=mongodb://127.0.0.1:27017/arts_by_jay
# Set to `true` to boot an ephemeral in-memory MongoDB instead.
# Data is WIPED on every restart. Local development only.
USE_MEMORY_DB=false

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=

# First account created with this email is granted the admin role.
# Leave blank to disable admin bootstrapping.
ADMIN_BOOTSTRAP_EMAIL=

# ── Payments ──────────────────────────────────────────────────
# One of: razorpay | stripe | dev | none
#   razorpay / stripe — real gateway, requires the keys below
#   dev    — simulated gateway for local testing. Orders are clearly
#            marked as simulated and it REFUSES to run when
#            NODE_ENV=production.
#   none   — checkout is disabled and says so honestly
PAYMENT_PROVIDER=none
CURRENCY=INR

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform commission withheld from artist earnings (percent).
# Applied to the artwork line total only, never to shipping. The rate in force
# is snapshotted onto every order item, so changing this NEVER alters what an
# artist was owed on a past sale.
PLATFORM_COMMISSION_PERCENT=10

# Days after confirmed delivery before an artist's share becomes payable.
# Nothing is treated as earned until this window closes with no open dispute.
RETURN_WINDOW_DAYS=7

# ── Razorpay Route (marketplace split payouts) ────────────────
# Route must be APPROVED on your Razorpay account before any of this works.
# Verify with: npm run test:razorpay
# When Route is off, artist payouts are tracked internally and settled
# manually by an administrator; the app says so rather than implying escrow.
RAZORPAY_ROUTE_ENABLED=false

# ── Image storage ─────────────────────────────────────────────
# One of: local | cloudinary
STORAGE_DRIVER=local
MAX_UPLOAD_MB=8
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Photo-to-Art studio ───────────────────────────────────────
# Leave blank. When blank the studio is a CSS-filter PREVIEW only
# and the UI says so. No customer photo ever leaves the browser
# unless a provider is configured AND the customer consents.
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=

# ── Email ─────────────────────────────────────────────────────
# Leave blank: notifications are stored in-app only, no mail is sent.
SMTP_URL=
MAIL_FROM=
