# ──────────────────────────────────────────────────────────────
# Arts by Jay — CLIENT environment
#
# Vite inlines every VITE_* value into the JavaScript bundle, which anyone can
# read. ONLY publishable keys belong here. Never a service_role key, never a
# Razorpay Key Secret, never a webhook secret.
# ──────────────────────────────────────────────────────────────

# ── Supabase ──
VITE_SUPABASE_URL=https://tdcdghuzasxkfdvactdz.supabase.co
# The anon / publishable key. Safe to ship: Row Level Security is what protects
# the data, not the secrecy of this key.
VITE_SUPABASE_ANON_KEY=

# ── Razorpay ──
# Key ID only. It is designed to be public and appears in the checkout script.
# The Key Secret stays server-side and is never referenced here.
VITE_RAZORPAY_KEY_ID=rzp_test_TsPMzji5nqQ09l

# ── API ──
# Left blank in development so requests go through the Vite proxy and stay
# same-origin (which also keeps 3D gallery textures free of CORS problems).
VITE_API_BASE_URL=
